PORT=5000
HOST=0.0.0.0
# Atlas example (replace user/pass/cluster — never commit real secrets):
# MONGODB_URI=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/dayflow?retryWrites=true&w=majority&appName=HRMSplatform
MONGODB_URI=mongodb://127.0.0.1:27017/dayflow
# Use single quotes if the secret contains $ < > ! etc.
JWT_SECRET='change-me-to-your-jwt-secret'
JWT_EXPIRES_IN=7d
NODE_ENV=development

# --- AI assistant (Groq + Qdrant) ---
# Without these, /api/ai returns 503; the rest of the API is unaffected.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
QDRANT_URL=
QDRANT_API_KEY=
# Set to false on memory-constrained hosts to disable policy retrieval
# (the embedding model uses ~150MB). All other AI tools keep working.
AI_RAG_ENABLED=true
